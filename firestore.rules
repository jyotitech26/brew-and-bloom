rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check auth
    function isAuthenticated() {
      return request.auth != null;
    }

    // Orders Collection: Anyone can create orders (anonymous/guest or authenticated); authenticated users can read/write their own orders
    match /orders/{orderId} {
      allow create: if true;
      allow read: if true;
      allow update, delete: if true;
    }

    // Users Collection: User profiles & loyalty points
    match /users/{userId} {
      allow read, write: if true;
    }

    // Live Cart collection
    match /liveCart/{cartId} {
      allow read, write: if true;
    }
  }
}
